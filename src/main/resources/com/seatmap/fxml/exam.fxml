<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seatmap.controller.ExamController"
      spacing="18">

    <VBox spacing="2">
        <Label text="Exam Manager" styleClass="page-title"/>
        <Label text="Create and manage scheduled examinations." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <TableView fx:id="examTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="subjectCol" text="Subject"/>
                    <TableColumn fx:id="dateCol" text="Exam Date"/>
                    <TableColumn fx:id="timeCol" text="Start Time"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No exams created yet. Use the form on the right to schedule an exam."/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="card" prefWidth="310" minWidth="290">
            <Label text="Exam Schedule" styleClass="card-title"/>

            <VBox spacing="5">
                <Label text="Subject" styleClass="field-label"/>
                <TextField fx:id="subjectField" promptText="e.g. Data Structures"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Exam Date" styleClass="field-label"/>
                <DatePicker fx:id="examDatePicker" maxWidth="Infinity" promptText="Select exam date"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Start Time (HH:mm)" styleClass="field-label"/>
                <TextField fx:id="startTimeField" promptText="e.g. 09:30 or 14:00"/>
            </VBox>

            <Region prefHeight="4"/>

            <HBox spacing="8">
                <Button fx:id="addButton" text="Add" onAction="#handleAdd" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="updateButton" text="Update" onAction="#handleUpdate" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
            </HBox>

            <HBox spacing="8">
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
                <Button text="Clear" onAction="#handleClearForm" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
