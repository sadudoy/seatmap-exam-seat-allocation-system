<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seatmap.controller.MyInvigilationsController"
      spacing="18">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="My Invigilations" styleClass="page-title"/>
            <Label text="Select an assigned examination room to view its seating chart and mark student attendance." styleClass="page-subtitle"/>
        </VBox>
        <Button text="Refresh" onAction="#loadAssignments" styleClass="btn-secondary"/>
        <Button fx:id="openSeatingButton" text="Open Seating Chart" onAction="#handleOpenSeatingChart"
                styleClass="btn-primary" disable="true"/>
    </HBox>

    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="invigilationTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="examSubjectCol" text="Exam Subject"/>
                <TableColumn fx:id="examDateCol" text="Exam Date"/>
                <TableColumn fx:id="examTimeCol" text="Start Time"/>
                <TableColumn fx:id="roomNumberCol" text="Assigned Room"/>
                <TableColumn fx:id="roomCapacityCol" text="Room Capacity"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="No exam rooms are currently assigned to your account."/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
