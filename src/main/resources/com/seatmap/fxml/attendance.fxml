<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seatmap.controller.AttendanceController"
      spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="Back to My Invigilations" onAction="#handleBack" styleClass="btn-secondary"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="headerTitleLabel" text="Room Attendance &amp; Seating Chart" styleClass="page-title"/>
            <Label fx:id="headerSubtitleLabel" text="Click any occupied desk to mark Present or Absent." styleClass="page-subtitle"/>
        </VBox>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
        <Button fx:id="exportAttendanceButton" text="Export Attendance PDF" onAction="#handleExportAttendancePdf" styleClass="btn-primary"/>
    </HBox>

    <HBox spacing="16" styleClass="card" alignment="CENTER_LEFT">
        <Label fx:id="summaryStatsLabel" text="Present: 0  |  Absent: 0  |  Pending: 0" styleClass="card-title" HBox.hgrow="ALWAYS"/>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Label text="Present" styleClass="legend-chip seat-present"/>
            <Label text="Absent" styleClass="legend-chip seat-absent"/>
            <Label text="Pending" styleClass="legend-chip seat-pending"/>
            <Label text="Empty" styleClass="legend-chip seat-card-empty"/>
        </HBox>
    </HBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="false" fitToHeight="false" VBox.vgrow="ALWAYS" styleClass="seat-scroll">
            <content>
                <GridPane fx:id="seatGrid" hgap="10" vgap="10">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>
                </GridPane>
            </content>
        </ScrollPane>
    </VBox>
</VBox>
