<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seatmap.controller.AssignmentsController"
      spacing="18">

    <VBox spacing="2">
        <Label text="Invigilator Assignments" styleClass="page-title"/>
        <Label text="Assign teachers to invigilate specific examination rooms." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Assigned Invigilators" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="removeButton" text="Remove Selected" onAction="#handleRemoveAssignment"
                        styleClass="btn-danger" disable="true"/>
            </HBox>

            <TableView fx:id="assignmentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="examCol" text="Exam Subject"/>
                    <TableColumn fx:id="dateCol" text="Exam Date"/>
                    <TableColumn fx:id="roomCol" text="Room"/>
                    <TableColumn fx:id="teacherCol" text="Assigned Teacher"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No invigilation assignments yet. Assign a teacher on the right."/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="card" prefWidth="330" minWidth="300">
            <Label text="New Assignment" styleClass="card-title"/>

            <VBox spacing="5">
                <Label text="Select Exam" styleClass="field-label"/>
                <ComboBox fx:id="examComboBox" maxWidth="Infinity" promptText="Choose Exam"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Select Room" styleClass="field-label"/>
                <ComboBox fx:id="roomComboBox" maxWidth="Infinity" promptText="Choose Room"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Select Teacher" styleClass="field-label"/>
                <ComboBox fx:id="teacherComboBox" maxWidth="Infinity" promptText="Choose Teacher"/>
            </VBox>

            <Region prefHeight="6"/>

            <Button text="Assign Invigilator" onAction="#handleAssignInvigilator"
                    styleClass="btn-primary" maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox>
