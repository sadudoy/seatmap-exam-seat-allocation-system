<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seatmap.controller.StudentController"
      spacing="18">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Student Manager" styleClass="page-title"/>
            <Label text="Search, add, update, or bulk import student records from CSV." styleClass="page-subtitle"/>
        </VBox>
        <Button text="Bulk Import CSV" onAction="#handleImportCsv" styleClass="btn-secondary"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search students by name..." HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
                <Button text="Search" onAction="#handleSearch" styleClass="btn-primary"/>
                <Button text="Show All" onAction="#handleResetSearch" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="rollCol" text="Roll Number"/>
                    <TableColumn fx:id="nameCol" text="Name"/>
                    <TableColumn fx:id="departmentCol" text="Department"/>
                    <TableColumn fx:id="semesterCol" text="Semester"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No students found. Add a student or import a CSV file."/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="card" prefWidth="310" minWidth="290">
            <Label fx:id="formTitleLabel" text="Add / Edit Student" styleClass="card-title"/>

            <VBox spacing="5">
                <Label text="Roll Number" styleClass="field-label"/>
                <TextField fx:id="rollField" promptText="e.g. CSE-2026-001"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Full Name" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="e.g. Alice Rahman"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Department" styleClass="field-label"/>
                <TextField fx:id="departmentField" promptText="e.g. CSE"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Semester" styleClass="field-label"/>
                <TextField fx:id="semesterField" promptText="e.g. 4"/>
            </VBox>

            <Region prefHeight="4"/>

            <HBox spacing="8">
                <Button fx:id="addButton" text="Add" onAction="#handleAdd" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="updateButton" text="Update" onAction="#handleUpdate" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
            </HBox>

            <HBox spacing="8">
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
                <Button text="Clear" onAction="#handleClearForm" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
