<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seatmap.controller.AllocationController"
      spacing="18">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Granular Allocation Engine" styleClass="page-title"/>
            <Label text="Filter eligible cohorts by department and semester, select a seating strategy, and generate room assignments." styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="viewSeatingButton" text="Open Seating Chart" onAction="#handleOpenSeatingChart" styleClass="btn-secondary"/>
    </HBox>

    <VBox spacing="14" styleClass="card">
        <HBox spacing="14" alignment="BOTTOM_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Select Exam" styleClass="field-label"/>
                <ComboBox fx:id="examComboBox" maxWidth="Infinity" promptText="Choose an exam"/>
            </VBox>

            <VBox spacing="5" prefWidth="250">
                <Label text="Seating Strategy" styleClass="field-label"/>
                <ComboBox fx:id="strategyComboBox" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <HBox spacing="14">
            <VBox spacing="8" styleClass="filter-box" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Filter by Department" styleClass="field-label" HBox.hgrow="ALWAYS"/>
                    <Button text="All" onAction="#handleSelectAllDepartments" styleClass="btn-link"/>
                    <Button text="Clear" onAction="#handleClearDepartments" styleClass="btn-link"/>
                </HBox>
                <FlowPane fx:id="departmentCheckPane" hgap="14" vgap="8"/>
            </VBox>

            <VBox spacing="8" styleClass="filter-box" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Filter by Semester" styleClass="field-label" HBox.hgrow="ALWAYS"/>
                    <Button text="All" onAction="#handleSelectAllSemesters" styleClass="btn-link"/>
                    <Button text="Clear" onAction="#handleClearSemesters" styleClass="btn-link"/>
                </HBox>
                <FlowPane fx:id="semesterCheckPane" hgap="14" vgap="8"/>
            </VBox>
        </HBox>

        <HBox spacing="14" alignment="CENTER_LEFT">
            <Button fx:id="generateButton" text="Generate Allocations" onAction="#handleGenerateAllocations" styleClass="btn-hero"/>
            <VBox spacing="2">
                <Label fx:id="matchingCountLabel" text="Matching students: 0" styleClass="field-label"/>
                <Label text="Unchecked groups match all values in that group; check specific items to narrow the cohort." styleClass="muted-label"/>
            </VBox>
        </HBox>

        <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Unallocated Students (Capacity / Constraint Overflow)" styleClass="card-title" HBox.hgrow="ALWAYS"/>
            <Label fx:id="summaryCountLabel" text="" styleClass="muted-label"/>
        </HBox>

        <TableView fx:id="unallocatedTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="unallocRollCol" text="Roll Number"/>
                <TableColumn fx:id="unallocNameCol" text="Name"/>
                <TableColumn fx:id="unallocDeptCol" text="Department"/>
                <TableColumn fx:id="unallocSemCol" text="Semester"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Run Generate Allocations to view status. Zero unallocated students means everyone was seated."/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
