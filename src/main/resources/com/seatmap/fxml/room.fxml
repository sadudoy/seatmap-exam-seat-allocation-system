<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seatmap.controller.RoomController"
      spacing="18">

    <VBox spacing="2">
        <Label text="Room Manager" styleClass="page-title"/>
        <Label text="Configure examination halls, grid rows/columns, and seat capacities." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
            <TableView fx:id="roomTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="roomNumberCol" text="Room Number"/>
                    <TableColumn fx:id="rowsCol" text="Rows"/>
                    <TableColumn fx:id="columnsCol" text="Columns"/>
                    <TableColumn fx:id="capacityCol" text="Capacity"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No examination rooms configured yet. Add a room on the right."/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="card" prefWidth="310" minWidth="290">
            <Label text="Room Details" styleClass="card-title"/>

            <VBox spacing="5">
                <Label text="Room Number" styleClass="field-label"/>
                <TextField fx:id="roomNumberField" promptText="e.g. Hall-301"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Rows" styleClass="field-label"/>
                    <TextField fx:id="rowsField" promptText="e.g. 5"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Columns" styleClass="field-label"/>
                    <TextField fx:id="columnsField" promptText="e.g. 6"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Seat Capacity" styleClass="field-label"/>
                <TextField fx:id="capacityField" promptText="e.g. 30 (max rows * columns)"/>
            </VBox>

            <Region prefHeight="4"/>

            <HBox spacing="8">
                <Button fx:id="addButton" text="Add" onAction="#handleAdd" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="updateButton" text="Update" onAction="#handleUpdate" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
            </HBox>

            <HBox spacing="8">
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
                <Button text="Clear" onAction="#handleClearForm" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
